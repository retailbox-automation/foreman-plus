# Mentra developer console (console.mentraglass.com) app registration.
# Package name MUST match the console registration exactly.
PACKAGE_NAME=com.retailbox.foreman
MENTRAOS_API_KEY=<from console — real value in Infisical, never committed>

# Foreman ADK api_server on Cloud Run (auth-only; bridge mints an ID token
# via ADC — service account locally, runtime SA on Cloud Run).
FOREMAN_RUN_URL=https://foreman-hello-112293816563.us-central1.run.app
FOREMAN_APP_NAME=foreman_app
FOREMAN_USER_ID=glass-tech

# Optional: forward non-command utterances to the Gemini Live guidance brain
# (live_brain/server.py) and speak its replies.
#LIVE_BRAIN_URL=http://localhost:7020

# Optional tuning
#PHOTO_SIZE=medium
#TRANSCRIBE_LANGS=en-US
PORT=8080
